# .env.local 로 복사해서 채우세요. 비밀값은 커밋 금지.
# Firebase 콘솔 > 프로젝트 설정 > 내 앱(웹). 비우면 가족·기록 기능은 오프라인 모드로 동작
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# 카카오톡 직접 공유 (선택). Kakao Developers에 서비스 도메인도 등록하세요.
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=

# Next.js 실전 대응 훈련: Dokploy 서버 환경변수에만 등록 (public 접두어 금지)
# TRAINING_GEMINI_API_KEY=  # GEMINI_API_KEY와 둘 중 하나
# TRAINING_GEMINI_MODEL=gemini-3.6-flash

# 가족 암호 링크 및 기기 저장 암호화 키 (선택, 권장). 오래 유지할 서버 전용 난수로 설정하세요.
# FAMILY_CODE_SECRET=
