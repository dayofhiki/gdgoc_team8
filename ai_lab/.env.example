# 이 파일을 .env로 복사해 값을 채우세요. .env는 Git에 올라가지 않습니다.
# 저장소 루트의 .env에 GEMINI_API_KEY가 있으면 그것도 읽습니다.
GEMINI_API_KEY=
# 선택 설정
# GEMINI_MODEL=gemini-3.6-flash
# BAITLAB_MAX_TURNS=6
# BAITLAB_MIN_CONFIDENCE=0.6
# BAITLAB_REPLY_TEMPERATURE=0.9
# BAITLAB_TIMEOUT_MS=60000
# BAITLAB_RETRY_ATTEMPTS=3
# BAITLAB_MIN_INTERVAL_S=12          # 무료 등급(분당 5회) 대비 호출 간격
# BAITLAB_RATE_LIMIT_MAX_WAIT_S=70   # 분당 한도 시 최대 대기
